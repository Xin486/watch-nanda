# Reference template; scripts/setup_hermes.py renders the actual service.
[Unit]
Description=Watch Nanda Hermes chat bridge
After=network-online.target watch-nanda-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__HERMES_USER__
Group=__HERMES_GROUP__
WorkingDirectory=__HERMES_BRIDGE_DIR__
Environment=HERMES_CLI=__HERMES_CLI__
Environment=HERMES_CHAT_WORKSPACE=__HERMES_WORKSPACE__
Environment=HERMES_CHAT_TURN_TIMEOUT_SECONDS=1800
ExecStart=__BRIDGE_PYTHON__ -m uvicorn hermes_bridge:app --host 127.0.0.1 --port 7981 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
