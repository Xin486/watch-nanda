# ============================================
# Node Monitor 数据库连接配置模板
# ============================================
# 部署步骤：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 按实际环境修改下面的值
#   3. 启动后端即可（无需改动任何代码）
#
# 说明：
#   - 环境变量（export 设置）优先级高于本文件
#   - 密码支持特殊字符，无需手动转义
# ============================================

# 数据库主机地址：本机数据库填 127.0.0.1，远程数据库填目标机器 IP
DB_HOST=127.0.0.1

# 数据库端口（MySQL 默认 3306）
DB_PORT=3306

# 数据库用户名（默认 root）
DB_USER=root

# 数据库密码（默认 NJU.edu@2026，与 setup.sh 自动生成的值一致）
DB_PASSWORD=NJU.edu@2026

# 数据库名
DB_NAME=monitor_db
