# 前端依赖及构建产物
node_modules/
dist/
npm-debug.log*
yarn-error.log*

# 后端依赖及缓存 (以 Python 为例)
__pycache__/
*.py[cod]
venv/
env/

# 环境变量及敏感配置
.env
.env.local

# 运行时日志
*.log
nohup.out

# Agent 节点凭据（签发后仅交给对应节点）
agent-*.json
agent/config.json

# 本地隔离验证依赖
/.tmp*
.venv/
.runtime/

# 本地分析报告、部署审计与截图
/outputs/

# 编辑器及系统文件
.vscode/
.idea/
.DS_Store
