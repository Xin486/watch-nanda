# 前端依赖及构建产物
node_modules/
dist/
npm-debug.log*
yarn-error.log*

# 后端依赖及缓存 (以 Python 为例)
__pycache__/
*.py[cod]
venv/
env/

# 环境变量及敏感配置
.env
.env.local

# 运行时产物（日志、调度残留文件）
*.log
nohup.out
celerybeat-schedule

# Agent 节点凭据（签发后仅交给对应节点）
agent-*.json
agent/config.json

# 本地隔离验证依赖
.tmp-backend-test-deps/
.venv/
.runtime/

# 编辑器及系统文件
.vscode/
.idea/
.DS_Store
